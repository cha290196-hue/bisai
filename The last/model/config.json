{
  "experiment_name": "flower_classification_100",
  "seed": 42,
  
  "model": {
    "name": "efficientnet_b4",
    "num_classes": 100,
    "pretrained": true,
    "dropout": 0.5
  },
  
  "data": {
    "image_size": 600,
    "train_path": "data/train.csv",
    "test_path": "data/test.csv",
    "num_workers": 4,
    "pin_memory": true
  },
  
  "training": {
    "batch_size": 32,
    "num_epochs": 100,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "gradient_clip": 1.0,
    "use_amp": true,
    "early_stopping_patience": 15
  },
  
  "augmentation": {
    "horizontal_flip": 0.5,
    "vertical_flip": 0.3,
    "rotation": 30,
    "color_jitter": {
      "brightness": 0.2,
      "contrast": 0.2,
      "saturation": 0.2,
      "hue": 0.1
    },
    "use_cutmix": false,
    "use_mixup": false,
    "cutmix_alpha": 1.0,
    "mixup_alpha": 1.0
  },
  
  "scheduler": {
    "type": "CosineAnnealingWarmRestarts",
    "T_0": 10,
    "T_mult": 2,
    "eta_min": 1e-6
  },
  
  "inference": {
    "use_tta": true,
    "tta_transforms": 5,
    "batch_size": 16
  },
  
  "paths": {
    "checkpoint_dir": "model/",
    "results_dir": "results/",
    "logs_dir": "logs/"
  }
}